# Obscura Browser CDP Configuration
OBSCURA_CDP_URL=ws://127.0.0.1:9222
# Optional path to local obscura binary if not on PATH
OBSCURA_BIN=

# TypeSafe Decision Engine
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Text LLM Helper (Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Logging
RUST_LOG=info
